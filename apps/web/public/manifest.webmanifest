{
  "name": "Cinelog",
  "short_name": "Cinelog",
  "description": "Track every film, series, anime, and documentary you watch — rate, review, and build your library.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "categories": ["entertainment", "lifestyle"],
  "shortcuts": [
    { "name": "Log a film", "short_name": "Log", "url": "/?log=1" },
    { "name": "Search", "short_name": "Search", "url": "/search" },
    { "name": "Watchlist", "short_name": "Watchlist", "url": "/watchlist" }
  ],
  "background_color": "#1a2025",
  "theme_color": "#1a2025",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
