// Cinelog — Prisma schema (SQLite).
//
// Notes on SQLite constraints (deliberate design choices):
//  - Prisma enums are unsupported on SQLite, so enum-like columns are String
//    and validated by the shared Zod contracts at the API boundary.
//  - JSON blobs are stored as String (Json scalar support on SQLite varies by
//    version); we serialize/parse in the service layer.
//  - Arrays are modeled as relations (e.g. Genre m:n) or JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         String   @default("USER") // UserRole: ADMIN | USER
  avatarUrl    String?
  bannerUrl    String?
  bio          String?
  ratingScale  String   @default("TEN") // RatingScale
  settings     String   @default("{}") // JSON: misc per-user prefs

  displayName         String?
  profileVisibility   String  @default("PUBLIC") // ProfileVisibility
  watchlistVisibility String  @default("PUBLIC") // ProfileVisibility

  // Letterboxd live sync: pulls the user's public diary RSS feed on demand.
  letterboxdUsername String?
  letterboxdSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  statuses       UserMediaStatus[]
  watchHistory   WatchHistory[]
  ratings        Rating[]
  episodeRatings EpisodeRating[]
  reviews        Review[]
  reviewLikes    ReviewLike[]
  reviewComments ReviewComment[]
  followedBy     Follow[]          @relation("Following")
  following      Follow[]          @relation("Follower")
  blockedBy      UserBlock[]       @relation("Blocked")
  blocking       UserBlock[]       @relation("Blocker")
  lists          List[]
  listLikes      ListLike[]
  listComments   ListComment[]
  activityEvents ActivityEvent[]   @relation("Actor")
  notifications  Notification[]    @relation("NotificationRecipient")
  reportsFiled   ContentReport[]   @relation("Reporter")
  moderationDone ModerationAction[] @relation("ModerationAdmin")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Canonical cached media metadata (shared across all users)
// ---------------------------------------------------------------------------

model MediaItem {
  id             String   @id @default(cuid())
  type           String // MediaType
  provider       String // ProviderId
  externalId     String
  title          String
  originalTitle  String?
  releaseDate    String?
  runtime        Int?
  overview       String?
  tagline        String?
  posterPath     String? // provider path/URL; served via the artwork proxy
  backdropPath   String?
  logoPath       String?
  providerRating Float? // provider's own average, normalized 0..100
  rawMetadata    String   @default("{}") // JSON: full provider detail (cast, crew, studios, trailer, artwork options)
  castOverride   String? // JSON: CreditPerson[] set by an admin; takes precedence over rawMetadata.cast
                         // and is never touched by cacheDetails/rematch, so it survives provider re-fetches.
  cachedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  genres   Genre[]           @relation("MediaGenres")
  statuses UserMediaStatus[]
  history  WatchHistory[]
  ratings  Rating[]
  seasons  Season[]
  reviews  Review[]
  listItems ListItem[]
  activityEvents ActivityEvent[]
  notifications  Notification[]

  @@unique([provider, externalId])
  @@index([type])
  @@map("media_items")
}

// Per-user artwork override: lets a user pick a different poster/backdrop than
// the media's default, from the set of images the provider offers. Never
// affects other users. Absence of a row means "use the provider default".
// ---------------------------------------------------------------------------
// Seasons & episodes (first-class; cached from the provider)
// ---------------------------------------------------------------------------

model Season {
  id           String   @id @default(cuid())
  mediaItemId  String
  seasonNumber Int
  name         String?
  overview     String?
  posterPath   String?
  airDate      String?
  episodeCount Int      @default(0)
  cachedAt     DateTime @default(now())

  media    MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([mediaItemId, seasonNumber])
  @@index([mediaItemId])
  @@map("seasons")
}

model Episode {
  id            String   @id @default(cuid())
  seasonId      String
  episodeNumber Int
  name          String?
  overview      String?
  stillPath     String?
  airDate       String?
  runtime       Int?

  season  Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  ratings EpisodeRating[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
  @@map("episodes")
}

// Per-user episode rating (normalized 0..100). Season/show averages are
// computed from these — never stored.
model EpisodeRating {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([episodeId])
  @@map("episode_ratings")
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  media MediaItem[] @relation("MediaGenres")

  @@map("genres")
}

// ---------------------------------------------------------------------------
// Per-user tracking (the isolation boundary)
// ---------------------------------------------------------------------------

model UserMediaStatus {
  id            String    @id @default(cuid())
  userId        String
  mediaItemId   String
  status        String? // TrackingStatus | null
  isFavorite    Boolean   @default(false)
  isWatchlisted Boolean   @default(false)
  favoritePosition Int? // 1..4 ranked favorite FILM slot on the profile; null = not featured
  favoriteShowPosition Int? // 1..4 ranked favorite SHOW slot on the profile; null = not featured
  rewatchCount  Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaItemId])
  @@unique([userId, favoritePosition])
  @@unique([userId, favoriteShowPosition])
  @@index([userId])
  @@map("user_media_status")
}

model WatchHistory {
  id          String   @id @default(cuid())
  userId      String
  mediaItemId String
  watchedAt   DateTime @default(now())
  isRewatch   Boolean  @default(false)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mediaItemId])
  @@map("watch_history")
}

// Per-user rating. Season/episode targets (nullable FKs) arrive with the
// episodes phase; Phase 1 rates media only.
model Rating {
  id          String   @id @default(cuid())
  userId      String
  mediaItemId String
  value       Float // normalized 0..100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaItemId])
  @@index([mediaItemId])
  @@map("ratings")
}

// ---------------------------------------------------------------------------
// Reviews, likes, comments
// ---------------------------------------------------------------------------

model Review {
  id           String    @id @default(cuid())
  userId       String
  mediaItemId  String
  targetType   String    @default("MEDIA") // TargetType
  body         String
  ratingValue  Float? // snapshot of the user's rating (0..100) at time of writing/editing
  watchedDate  DateTime?
  isSpoiler    Boolean   @default(false)
  likeCount    Int       @default(0) // denormalized, maintained by ReviewLike create/delete
  commentCount Int       @default(0) // denormalized, maintained by ReviewComment create/delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  editedAt     DateTime?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  likes    ReviewLike[]
  comments ReviewComment[]

  @@unique([userId, mediaItemId, targetType])
  @@index([mediaItemId])
  @@index([userId])
  @@map("reviews")
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_likes")
}

model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_comments")
}

// ---------------------------------------------------------------------------
// Social graph
// ---------------------------------------------------------------------------

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

// ---------------------------------------------------------------------------
// Lists
// ---------------------------------------------------------------------------

model List {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    ListItem[]
  likes    ListLike[]
  comments ListComment[]

  @@index([userId])
  @@map("lists")
}

model ListItem {
  id          String   @id @default(cuid())
  listId      String
  mediaItemId String
  position    Int
  note        String?
  createdAt   DateTime @default(now())

  list  List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaItemId])
  @@index([listId])
  @@map("list_items")
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
  @@map("list_likes")
}

model ListComment {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@map("list_comments")
}

// ---------------------------------------------------------------------------
// Activity feed & notifications
// ---------------------------------------------------------------------------

model ActivityEvent {
  id           String   @id @default(cuid())
  actorId      String
  type         String // ActivityType
  mediaItemId  String?
  reviewId     String?
  listId       String?
  targetUserId String? // e.g. the user that was followed
  createdAt    DateTime @default(now())

  actor User       @relation("Actor", fields: [actorId], references: [id], onDelete: Cascade)
  media MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@map("activity_events")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String // recipient
  type        String // NotificationType
  actorId     String?
  mediaItemId String?
  reviewId    String?
  listId      String?
  commentId   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user  User       @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

model ContentReport {
  id           String    @id @default(cuid())
  reporterId   String
  targetType   String // ReportTargetType
  targetId     String
  reason       String
  status       String    @default("OPEN") // ReportStatus
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("content_reports")
}

model ModerationAction {
  id         String   @id @default(cuid())
  adminId    String
  actionType String
  targetType String // ReportTargetType
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  admin User @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

// ---------------------------------------------------------------------------
// Artwork cache & global settings
// ---------------------------------------------------------------------------

model ArtworkCache {
  id          String   @id @default(cuid())
  sourceUrl   String   @unique
  localPath   String
  hash        String
  bytes       Int
  contentType String?
  fetchedAt   DateTime @default(now())

  @@map("artwork_cache")
}

model Setting {
  key   String @id
  value String // JSON

  @@map("settings")
}
